{
  "name": "firebot-aimp",
  "displayName": "AIMP",
  "pluginOutputName": "oceanityAIMP",
  "version": "1.0.0",
  "description": "Allows Firebot to control AIMP and read live data about the currently playing track. Includes Overlay Widgets to show track details and cover art on stream.",
  "main": "",
  "scripts": {
    "build": "tsdown",
    "build:dev": "npm run build && npm run copy",
    "copy": "node ./scripts/copy-build.js",
    "test": "jest"
  },
  "author": "Oceanity",
  "license": "GPL-3.0",
  "devDependencies": {
    "@crowbartools/firebot-types": "^5.67.0-beta1",
    "@types/jest": "^30.0.0",
    "@types/jquery": "^4.0.1",
    "@types/node": "^22.20.1",
    "jest": "^30.0.0",
    "reconnecting-websocket": "^4.4.0",
    "tiny-typed-emitter": "^2.1.0",
    "ts-jest": "^29.4.12",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "uuid": "^14.0.2"
  },
  "volta": {
    "node": "24.10.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
